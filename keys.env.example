# Keys & Secrets Reference
# ============================================================
# This file documents all required API keys / secrets.
# DO NOT put actual values here — this file is gitignored.
# Store real values in keys.env or your system environment.
# ============================================================

# Example format:
# VARIABLE_NAME=              # Description of what it is / where to get it

# ------------------------------------
#  Launcher Integrations
# ------------------------------------
STEAM_API_KEY=                # Steam Web API key — https://steamcommunity.com/dev/apikey
VITE_STEAM_API_KEY=           # Steam Web API key (for frontend access if needed)
EPIC_CLIENT_ID=               # Epic Games OAuth client ID (optional)
EPIC_CLIENT_SECRET=           # Epic Games OAuth client secret (optional)
GOG_CLIENT_ID=                # GOG Galaxy client ID (optional)
GOG_CLIENT_SECRET=            # GOG Galaxy client secret (optional)

# ------------------------------------
#  Supabase (Cloud Storage & Auth)
# ------------------------------------
# VITE_SUPABASE_URL=          # Supabase project URL (https://<project-ref>.supabase.co)
# VITE_SUPABASE_ANON_KEY=     # Supabase anon / public API key

# ------------------------------------
#  Application
# ------------------------------------
# APP_SECRET=                 # General application secret / encryption key

# ------------------------------------
#  CI / CD & GitHub Actions
# ------------------------------------
# GEMINI_API_KEY=             # Google Gemini API key (stored in GitHub Repository Secrets for issue enhancement workflow)

