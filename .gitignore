# ============================================================
#  Unity Game Launcher — .gitignore
# ============================================================

# ------------------------------------
#  Secrets & API Keys
# ------------------------------------
keys.env
keys.txt
*.key
*.pem
secrets.*
.env
.env.*
!.env.example

# ------------------------------------
#  Tooling & Configs
# ------------------------------------
.gemini/
.agents/
antigravity/
.vibecoding/
vibecoding/


# ------------------------------------
#  OS — Windows
# ------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ------------------------------------
#  OS — macOS
# ------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*

# ------------------------------------
#  OS — Linux
# ------------------------------------
*~
.directory

# ------------------------------------
#  IDEs & Editors
# ------------------------------------
# Visual Studio / VS Code
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates

# JetBrains (Rider, IntelliJ, etc.)
.idea/
*.iml

# ------------------------------------
#  Build Outputs & Packages
# ------------------------------------
bin/
obj/
out/
dist/
dist-electron/
release/
build/
data/
*.exe
*.dll
*.pdb
*.msi
*.msix
*.nupkg
*.jar
*.tsbuildinfo
.vite/
node_modules/
.nuget/
packages/


# ------------------------------------
#  Logs & Temp Files
# ------------------------------------
*.log
*.tmp
*.bak
*.swp
*.cache
logs/
temp/
tmp/

# ------------------------------------
#  Unity (if any Unity assets are used)
# ------------------------------------
/[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
*.pidb
*.booproj
*.svd
*.pdb
sysinfo.txt
*.unityproj
