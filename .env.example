# ============================================================
#  Unity Game Launcher — Environment Variables (.env.example)
#  Copy this file to .env and fill in your values
# ============================================================

# Supabase (Cloud Storage, Database & Authentication)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Steam Web API (For uninstalled owned game sync & achievements)
STEAM_API_KEY=your-steam-web-api-key-here
VITE_STEAM_API_KEY=your-steam-web-api-key-here

